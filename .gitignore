# Build output
/bin/
/target/

# Embedded SPA build (produced by `make web` from web/build/)
/assets/dist/*
!/assets/dist/.gitkeep

# Frontend
/web/node_modules/
/web/build/
/web/.svelte-kit/
/web/test-results/
/web/playwright-report/

# Node (only if you ever switch to npm-based Tooling)
node_modules/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test/coverage artifacts
*.test
*.out
coverage.*

# Environment / secrets
.env
.env.*
!.env.example

# SQLite database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
docker-compose.yml
