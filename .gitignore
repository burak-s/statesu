# Build output
/bin/

# Embedded SPA build (produced by `make web` from web/build/)
/internal/spa/dist/*
!/internal/spa/dist/.gitkeep

# Frontend
/web/node_modules/
/web/build/
/web/.svelte-kit/

# Node (only if you ever switch to npm-based Tooling)
node_modules/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go test/coverage artifacts
*.test
*.out
coverage.*

# Go workspace files
go.work
go.work.sum

# Environment / secrets
.env
.env.*
!.env.example

# SQLite database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
docker-compose.yml
