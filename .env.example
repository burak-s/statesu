# Statesu configuration.
# Copy to `.env` and fill in the values. Explicit environment variables always
# win over the file; the file itself is optional in production.
# Secrets: generate 32-byte base64 values with
#   openssl rand -base64 32

# ---------------------------------------------------------------------------
# Accounts and mail
# ---------------------------------------------------------------------------

# AES-256-GCM key for encrypting user email addresses at rest.
# Required. Exactly 32 bytes, standard base64.
STATESU_EMAIL_KEY=

# HMAC-SHA256 key for looking up users by normalized email (the only email
# form that reaches SQL). Required. At least 32 bytes, standard base64.
# Use a different value than STATESU_EMAIL_KEY.
STATESU_EMAIL_HMAC_KEY=

# Resend API key for sending verification mail. Server-only secret; never
# leaves the backend. Required.
STATESU_RESEND=

# `From` header for verification mail, e.g. `Statesu Security <verify@domain>`.
# The sending domain must first be verified inside Resend. Required.
STATESU_MAIL_FROM=

# The public origin your dashboard is served from, e.g.
# https://security.statesu.com - no path, no trailing slash. Used to build
# verification links and pin same-site cookie writes; host headers are never
# trusted for either. Required.
STATESU_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# SQLite database file. Created on first run. Default: db/statesu.db
STATESU_DB=

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------

# TCP bind address. Leading `:` binds 0.0.0.0; behind a reverse proxy bind to
# loopback instead. Default and local value: :8080 / 127.0.0.1:8080
STATESU_ADDR=127.0.0.1:8080

# Exact browser origins of the dashboard, comma-separated (CORS allowlist for
# management routes). Same origin as STATESU_PUBLIC_URL in the recommended
# single-origin deployment. No effect on public delivery; each blog owner
# decides those origins themselves.
STATESU_ALLOWED_ORIGINS=http://localhost:5173

# CIDR ranges of reverse proxies you own, comma-separated
# (e.g. 173.245.48.0/20 for Cloudflare). Only peers inside these ranges are
# allowed to set X-Forwarded-For for rate limiting. Default: none.
STATESU_TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------

# Requests per minute per client IP for everything except the sensitive auth
# routes. Default: 120
STATESU_RATE_LIMIT_RPM=

# Requests per minute per client IP for register/login/verify/resend.
# Default: 10
STATESU_AUTH_RATE_LIMIT_RPM=

# Maximum concurrent requests; overflow gets a 503 instead of queueing.
# Default: 128
STATESU_MAX_CONCURRENCY=

# Parallel workers for Argon2 password hashing. Scale this to CPU cores.
# Default: 2
STATESU_ARGON2_CONCURRENCY=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Log as one JSON object per line (for log shippers) instead of plain text.
# true or false. Default: false
STATESU_LOG_JSON=
