# Dashboard build configuration.
# Copy to `.env` and fill in the values before `make web` / `npm run build`.
# These are SvelteKit public env values (safe to ship to the browser).

# ---------------------------------------------------------------------------
# Human verification
# ---------------------------------------------------------------------------

# Cloudflare Turnstile site key (the public half of the widget) baked into
# the dashboard login/register forms. Create the widget for the dashboard
# origin (same host as the backend's STATESU_PUBLIC_URL) and keep its secret
# in the backend's STATESU_TURNSTILE_SECRET_KEY. Set both keys or neither:
# an empty site key removes the widget from the forms, while an empty
# backend secret makes the backend ignore it.
PUBLIC_TURNSTILE_SITE_KEY=
