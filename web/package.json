{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run build:sveltekit && npm run build:embed",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"build:sveltekit": "vite build",
		"build:embed": "vite build --config vite.embed.config.js",
		"test": "node --test tests/*.test.js",
		"test:browser": "playwright test",
		"test:browser:headed": "playwright test --headed"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"jsdom": "^30.1.3",
		"svelte": "^5.56.7",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"dompurify": "^3.4.17",
		"marked": "^18.1.2"
	}
}
